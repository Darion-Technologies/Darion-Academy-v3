# PostgreSQL runtime connection, typically a pooled URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Direct/session connection used by Prisma schema synchronization and migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Supabase browser/server authentication.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="SUPABASE_ANON_KEY"

# Server-only key used for invitations, private storage, and certificate generation.
SUPABASE_SERVICE_ROLE_KEY="SUPABASE_SERVICE_ROLE_KEY"

# Public origin used in invite, recovery, and certificate verification links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Salt for one-way IP hashing in session records.
SESSION_IP_SALT="replace-with-a-long-random-secret"
