  noteInputContainer: { padding: 16, borderRadius: 12, borderWidth: 1, marginBottom: 24 },
  noteInput: { fontSize: 15, minHeight: 80, textAlignVertical: 'top' },
  noteActions: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginTop: 12 },
  doubtCheckbox: { flexDirection: 'row', alignItems: 'center', gap: 6 },
  doubtText: { fontSize: 13, fontWeight: '600' },
  addNoteBtn: { paddingHorizontal: 16, paddingVertical: 8, borderRadius: 16 },
  addNoteText: { color: '#fff', fontSize: 13, fontWeight: '700' },
