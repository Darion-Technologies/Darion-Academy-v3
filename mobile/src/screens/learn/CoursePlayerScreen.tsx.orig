  scrollContent: { flex: 1 },
  tabContent: { padding: 20 },
  noteInput: { flex: 1, borderWidth: 1, borderRadius: 8, paddingHorizontal: 12, height: 44, marginRight: 8 },
  addNoteBtn: { width: 44, height: 44, borderRadius: 8, justifyContent: 'center', alignItems: 'center' },
  noteCard: { borderWidth: 1, borderRadius: 8, padding: 12, marginBottom: 12 },
