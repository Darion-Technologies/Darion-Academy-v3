generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String                    @id @db.Uuid
  email               String                    @unique
  name                String
  role                UserRole                  @default(EMPLOYEE)
  department          String?
  avatarUrl           String?
  active              Boolean                   @default(true)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  employeeId          String?                   @unique
  lastLoginAt         DateTime?
  totalShortScore     Int                       @default(0)
  activity            ActivityLog[]
  certificatesIssued  Certificate[]             @relation("CertificateIssuer")
  certificatesRevoked Certificate[]             @relation("CertificateRevoker")
  certificates        Certificate[]
  conversations       ConversationParticipant[]
  enrollments         Enrollment[]              @relation("LearnerEnrollments")
  mentoredEnrollments Enrollment[]              @relation("EnrollmentMentor")
  expoPushTokens      ExpoPushToken[]
  feedbackAuthored    Feedback[]                @relation("FeedbackAuthor")
  preference          LearningPreference?
  loginStreaks        LoginStreak[]
  messages            Message[]
  notifications       Notification[]
  personalEvents      PersonalEvent[]
  progress            Progress[]
  pushSubscriptions   PushSubscription[]
  quizAttempts        QuizAttempt[]
  shortBookmarks      ShortBookmark[]
  shortComments       ShortComment[]
  shortNotes          ShortNote[]
  shortProgress       ShortProgress[]
  submissions         Submission[]              @relation("LearnerSubmissions")
  reviewedSubmissions Submission[]              @relation("SubmissionReviewer")
  badges              UserBadge[]               @relation("UserBadges")
  sessions            UserSession[]
  videoNotes          VideoNote[]
  videoProgress       VideoProgress[]
}

model UserSession {
  id              String    @id @default(cuid())
  userId          String    @db.Uuid
  sessionId       String    @unique
  device          String?
  browser         String?
  operatingSystem String?
  ipHash          String?
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime  @updatedAt
  revokedAt       DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model LearningPreference {
  id                String          @id @default(cuid())
  userId            String          @unique @db.Uuid
  resumeLastLesson  Boolean         @default(true)
  defaultLessonView String          @default("STANDARD")
  courseReminders   Boolean         @default(true)
  reviewUpdates     Boolean         @default(true)
  certificateAlerts Boolean         @default(true)
  updatedAt         DateTime        @updatedAt
  theme             AppearanceTheme @default(SYSTEM)
  sidebarCollapsed  Boolean         @default(false)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginStreak {
  id     String   @id @default(cuid())
  userId String   @db.Uuid
  date   DateTime @db.Date
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model Course {
  id                    String               @id @default(cuid())
  title                 String
  slug                  String               @unique
  description           String
  category              String
  difficulty            Difficulty           @default(BEGINNER)
  estimatedMinutes      Int                  @default(60)
  thumbnailUrl          String?
  status                CourseStatus         @default(DRAFT)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  certificateTemplateId String?
  deadlineDays          Int?
  certificates          Certificate[]
  certificateTemplate   CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id])
  enrollments           Enrollment[]
  modules               Module[]
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, order])
}

model Lesson {
  id                 String          @id @default(cuid())
  moduleId           String
  title              String
  type               LessonType
  content            String?
  videoUrl           String?
  fileUrl            String?
  externalUrl        String?
  order              Int
  completionRequired Boolean         @default(true)
  estimatedMinutes   Int             @default(10)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  transcriptUrl      String?
  videoDuration      Int?
  videoEndTime       Int?
  videoStartTime     Int?
  assignment         Assignment?
  module             Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress           Progress[]
  quiz               Quiz?
  videoNotes         VideoNote[]
  videoProgress      VideoProgress[]

  @@unique([moduleId, order])
}

model Enrollment {
  id              String           @id @default(cuid())
  learnerId       String           @db.Uuid
  courseId        String
  mentorId        String?          @db.Uuid
  status          EnrollmentStatus @default(ASSIGNED)
  progressPercent Int              @default(0)
  assignedAt      DateTime         @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  approvedAt      DateTime?
  deadlineAt      DateTime?
  certificates    Certificate[]
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learner         User             @relation("LearnerEnrollments", fields: [learnerId], references: [id], onDelete: Cascade)
  mentor          User?            @relation("EnrollmentMentor", fields: [mentorId], references: [id])

  @@unique([learnerId, courseId])
  @@index([mentorId])
}

model Progress {
  id          String    @id @default(cuid())
  userId      String    @db.Uuid
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model VideoProgress {
  id           String   @id @default(cuid())
  userId       String   @db.Uuid
  lessonId     String
  timestamp    Int      @default(0)
  completed    Boolean  @default(false)
  updatedAt    DateTime @updatedAt
  maxTimestamp Int      @default(0)
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model VideoNote {
  id          String    @id @default(cuid())
  userId      String    @db.Uuid
  lessonId    String
  timestamp   Int
  text        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isDoubt     Boolean   @default(false)
  resolved    Boolean   @default(false)
  mentorReply String?
  repliedAt   DateTime?
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
}

model Assignment {
  id           String       @id @default(cuid())
  lessonId     String       @unique
  instructions String
  allowText    Boolean      @default(true)
  allowFile    Boolean      @default(true)
  allowLink    Boolean      @default(true)
  dueDays      Int?
  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions  Submission[]
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  learnerId    String           @db.Uuid
  reviewerId   String?          @db.Uuid
  textAnswer   String?
  fileUrl      String?
  externalUrl  String?
  status       SubmissionStatus @default(PENDING)
  submittedAt  DateTime?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  feedback     Feedback[]
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  learner      User             @relation("LearnerSubmissions", fields: [learnerId], references: [id], onDelete: Cascade)
  reviewer     User?            @relation("SubmissionReviewer", fields: [reviewerId], references: [id])

  @@unique([assignmentId, learnerId])
  @@index([learnerId])
}

model Feedback {
  id           String     @id @default(cuid())
  submissionId String
  authorId     String     @db.Uuid
  message      String
  createdAt    DateTime   @default(now())
  author       User       @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Quiz {
  id                       String        @id @default(cuid())
  lessonId                 String        @unique
  title                    String
  instructions             String?
  passMark                 Int           @default(70)
  maxAttempts              Int?
  isStrict                 Boolean       @default(false)
  timeLimit                Int?
  requireShortAnswerReview Boolean       @default(false)
  questions                Question[]
  lesson                   Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts                 QuizAttempt[]
}

model Question {
  id            String       @id @default(cuid())
  quizId        String
  prompt        String
  type          QuestionType
  options       Json?
  correctAnswer String
  points        Int          @default(1)
  order         Int
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers       QuizAnswer[]

  @@unique([quizId, order])
}

model QuizAttempt {
  id           String        @id @default(cuid())
  quizId       String
  userId       String        @db.Uuid
  score        Int           @default(0)
  earnedPoints Int           @default(0)
  totalPoints  Int           @default(0)
  status       AttemptStatus @default(IN_PROGRESS)
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?
  warnings     Int           @default(0)
  answers      QuizAnswer[]
  quiz         Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId, userId])
  @@index([userId])
}

model QuizAnswer {
  id           String      @id @default(cuid())
  attemptId    String
  questionId   String
  answer       String
  isCorrect    Boolean
  pointsEarned Int         @default(0)
  attempt      QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question     Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model Certificate {
  id               String               @id @default(cuid())
  certificateId    String               @unique
  enrollmentId     String
  userId           String               @db.Uuid
  courseId         String
  status           CertificateStatus    @default(ELIGIBLE)
  score            Int?
  fileUrl          String?
  issuedAt         DateTime?
  createdAt        DateTime             @default(now())
  templateId       String?
  issuerId         String?              @db.Uuid
  revokedById      String?              @db.Uuid
  replacesId       String?
  templateSnapshot Json?
  failureReason    String?
  revokedReason    String?
  revokedAt        DateTime?
  updatedAt        DateTime             @updatedAt
  course           Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment       Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  issuer           User?                @relation("CertificateIssuer", fields: [issuerId], references: [id])
  replaces         Certificate?         @relation("CertificateReplacement", fields: [replacesId], references: [id])
  replacements     Certificate[]        @relation("CertificateReplacement")
  revokedBy        User?                @relation("CertificateRevoker", fields: [revokedById], references: [id])
  template         CertificateTemplate? @relation(fields: [templateId], references: [id])
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@index([status])
  @@index([userId])
}

model CertificateTemplate {
  id                 String                    @id @default(cuid())
  name               String                    @unique
  status             CertificateTemplateStatus @default(ACTIVE)
  isDefault          Boolean                   @default(false)
  primaryColor       String                    @default("#143c72")
  accentColor        String                    @default("#1764c0")
  backgroundColor    String                    @default("#f7f9fc")
  textColor          String                    @default("#10213b")
  fontFamily         String                    @default("Arial")
  headingFontFamily  String                    @default("Georgia")
  borderStyle        String                    @default("DOUBLE")
  borderWidth        Int                       @default(2)
  textAlign          String                    @default("CENTER")
  title              String                    @default("Certificate of Completion")
  presentationText   String                    @default("This certificate is proudly presented to")
  completionText     String                    @default("for successfully completing")
  showScore          Boolean                   @default(true)
  showCompletionDate Boolean                   @default(true)
  showCertificateId  Boolean                   @default(true)
  showQrCode         Boolean                   @default(true)
  signerName         String?
  signerTitle        String?
  logoUrl            String?
  signatureUrl       String?
  backgroundUrl      String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  certificates       Certificate[]
  courses            Course[]
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @db.Uuid
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  href      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([createdAt])
}

model Badge {
  id          String      @id @default(cuid())
  name        String
  description String
  type        BadgeType
  iconUrl     String?
  color       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  badgeId   String
  period    String?
  metadata  Json?
  awardedAt DateTime @default(now())
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user      User     @relation("UserBadges", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ExpoPushToken {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model YouTubeShort {
  id              String          @id @default(cuid())
  youtubeVideoId  String          @unique
  title           String
  description     String?
  channelName     String?
  channelId       String?
  thumbnailUrl    String?
  durationSeconds Int
  sourceUrl       String
  category        String
  tags            String[]
  approved        Boolean         @default(false)
  rejected        Boolean         @default(false)
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  shortScore      Int             @default(5)
  transcript      String?
  bookmarks       ShortBookmark[]
  comments        ShortComment[]
  notes           ShortNote[]
  progress        ShortProgress[]
  quizzes         ShortQuiz[]
}

model ShortProgress {
  id        String       @id @default(cuid())
  userId    String       @db.Uuid
  shortId   String
  watched   Boolean      @default(false)
  watchedAt DateTime?
  createdAt DateTime     @default(now())
  short     YouTubeShort @relation(fields: [shortId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shortId])
}

model ShortBookmark {
  id        String       @id @default(cuid())
  userId    String       @db.Uuid
  shortId   String
  createdAt DateTime     @default(now())
  short     YouTubeShort @relation(fields: [shortId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shortId])
}

model ShortQuiz {
  id          String       @id @default(cuid())
  shortId     String
  question    String
  optionA     String
  optionB     String
  optionC     String
  optionD     String
  answer      String
  explanation String?
  createdAt   DateTime     @default(now())
  short       YouTubeShort @relation(fields: [shortId], references: [id], onDelete: Cascade)
}

model ShortComment {
  id        String       @id @default(cuid())
  shortId   String
  userId    String       @db.Uuid
  text      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  short     YouTubeShort @relation(fields: [shortId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shortId, createdAt(sort: Desc)])
}

model ShortNote {
  id        String       @id @default(cuid())
  userId    String       @db.Uuid
  shortId   String
  content   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  short     YouTubeShort @relation(fields: [shortId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shortId])
}

model Conversation {
  id           String                    @id @default(cuid())
  type         ConversationType
  name         String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id                String          @id @default(cuid())
  conversationId    String
  userId            String          @db.Uuid
  role              ParticipantRole @default(MEMBER)
  lastReadMessageId String?
  joinedAt          DateTime        @default(now())
  lastDeliveredAt   DateTime?
  lastReadAt        DateTime?
  conversation      Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String       @db.Uuid
  content        String
  createdAt      DateTime     @default(now())
  attachmentType String?
  attachmentUrl  String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model PersonalEvent {
  id          String   @id @default(cuid())
  userId      String   @db.Uuid
  title       String
  description String?
  date        DateTime @db.Date
  color       String   @default("blue")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum UserRole {
  ADMIN
  MENTOR
  EMPLOYEE
  INTERN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonType {
  TEXT
  YOUTUBE
  PDF
  LINK
  ASSIGNMENT
  QUIZ
  VIDEO
}

enum EnrollmentStatus {
  ASSIGNED
  IN_PROGRESS
  AWAITING_APPROVAL
  COMPLETED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  NEEDS_CORRECTION
  APPROVED
  REJECTED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum AttemptStatus {
  IN_PROGRESS
  PASSED
  FAILED
  TIMEOUT
  TERMINATED
}

enum CertificateStatus {
  ELIGIBLE
  GENERATED
  REVOKED
  ISSUING
  FAILED
}

enum CertificateTemplateStatus {
  ACTIVE
  INACTIVE
}

enum NotificationType {
  COURSE_ASSIGNED
  SUBMISSION_REVIEWED
  FEEDBACK_ADDED
  CERTIFICATE_GENERATED
  GENERAL
  DEADLINE_REMINDER
  DAILY_NUDGE
}

enum AppearanceTheme {
  SYSTEM
  LIGHT
  DARK
}

enum BadgeType {
  WEEKLY_STAR
  MONTHLY_HERO
  YEARLY_CHAMPION
  ACHIEVEMENT
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ParticipantRole {
  MEMBER
  ADMIN
}
